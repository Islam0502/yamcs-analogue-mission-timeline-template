<?xml version="1.0" encoding="UTF-8"?>
<SpaceSystem
    name="GENERAL"
    xmlns="http://www.omg.org/spec/XTCE/20180204"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.omg.org/spec/XTCE/20180204 https://www.omg.org/spec/XTCE/20180204/SpaceSystem.xsd">

  <TelemetryMetaData>

    <ParameterTypeSet>

      <FloatParameterType name="RH_Float32" sizeInBits="32">
        <UnitSet>
          <Unit>%RH</Unit>
        </UnitSet>
        <ValidRange minInclusive="0" maxInclusive="100"/>
        <DefaultAlarm>
          <StaticAlarmRanges>
            <WarningRange minInclusive="40" maxInclusive="70"/>
            <CriticalRange minInclusive="30" maxInclusive="80"/>
          </StaticAlarmRanges>
        </DefaultAlarm>
      </FloatParameterType>

      <IntegerParameterType name="CO2_UInt32" signed="false" sizeInBits="32">
        <UnitSet>
          <Unit>ppm</Unit>
        </UnitSet>
        <ValidRange minInclusive="0" maxInclusive="100000"/>
        <DefaultAlarm>
          <StaticAlarmRanges>
            <WarningRange minInclusive="500" maxInclusive="1800"/>
            <CriticalRange minInclusive="400" maxInclusive="2500"/>
          </StaticAlarmRanges>
        </DefaultAlarm>
      </IntegerParameterType>

      <!-- AirQ1 exposes VOC/NOX as index-style values through ESPHome/Home Assistant, not ppb. -->
      <FloatParameterType name="AQI_Index_Float32" sizeInBits="32">
        <UnitSet />
        <ValidRange minInclusive="0" maxInclusive="500"/>
      </FloatParameterType>

      <FloatParameterType name="Temperature_Float32" sizeInBits="32">
        <UnitSet>
          <Unit>degC</Unit>
        </UnitSet>
        <ValidRange minInclusive="-40" maxInclusive="80"/>
        <DefaultAlarm>
          <StaticAlarmRanges>
            <WarningRange minInclusive="15" maxInclusive="25"/>
            <CriticalRange minInclusive="10" maxInclusive="30"/>
          </StaticAlarmRanges>
        </DefaultAlarm>
      </FloatParameterType>

      <FloatParameterType name="PM1_Float32" sizeInBits="32">
        <UnitSet>
          <Unit>µg/m3</Unit>
        </UnitSet>
        <ValidRange minInclusive="0" maxInclusive="5000"/>
        <DefaultAlarm>
          <StaticAlarmRanges>
            <WarningRange minInclusive="2" maxInclusive="3"/>
            <CriticalRange minInclusive="1" maxInclusive="5"/>
          </StaticAlarmRanges>
        </DefaultAlarm>
      </FloatParameterType>

      <FloatParameterType name="PM2_5_Float32" sizeInBits="32">
        <UnitSet>
          <Unit>µg/m3</Unit>
        </UnitSet>
        <ValidRange minInclusive="0" maxInclusive="5000"/>
        <DefaultAlarm>
          <StaticAlarmRanges>
            <WarningRange minInclusive="6" maxInclusive="15"/>
            <CriticalRange minInclusive="3" maxInclusive="25"/>
          </StaticAlarmRanges>
        </DefaultAlarm>
      </FloatParameterType>

      <FloatParameterType name="PM4_Float32" sizeInBits="32">
        <UnitSet>
          <Unit>µg/m3</Unit>
        </UnitSet>
        <ValidRange minInclusive="0" maxInclusive="5000"/>
        <DefaultAlarm>
          <StaticAlarmRanges>
            <WarningRange minInclusive="15" maxInclusive="45"/>
            <CriticalRange minInclusive="8" maxInclusive="60"/>
          </StaticAlarmRanges>
        </DefaultAlarm>
      </FloatParameterType>

      <FloatParameterType name="PM10_Float32" sizeInBits="32">
        <UnitSet>
          <Unit>µg/m3</Unit>
        </UnitSet>
        <ValidRange minInclusive="0" maxInclusive="5000"/>
        <DefaultAlarm>
          <StaticAlarmRanges>
            <WarningRange minInclusive="15" maxInclusive="45"/>
            <CriticalRange minInclusive="8" maxInclusive="60"/>
          </StaticAlarmRanges>
        </DefaultAlarm>
      </FloatParameterType>

      <IntegerParameterType name="WiFiSignal_Int32" signed="true" sizeInBits="32">
        <UnitSet>
          <Unit>dBm</Unit>
        </UnitSet>
        <ValidRange minInclusive="-120" maxInclusive="0"/>
      </IntegerParameterType>

    </ParameterTypeSet>

    <ParameterSet>

      <Parameter name="temperature" parameterTypeRef="Temperature_Float32" shortDescription="Ambient temperature">
        <LongDescription>Primary ambient temperature in degrees Celsius from the AirQ1 device.</LongDescription>
        <ParameterProperties dataSource="local"/>
      </Parameter>

      <Parameter name="humidity" parameterTypeRef="RH_Float32" shortDescription="Relative humidity">
        <LongDescription>Primary relative humidity (%RH) from the AirQ1 device.</LongDescription>
        <ParameterProperties dataSource="local"/>
      </Parameter>

      <Parameter name="co2" parameterTypeRef="CO2_UInt32" shortDescription="CO2 concentration">
        <LongDescription>Carbon dioxide concentration in ppm from the AirQ1 device.</LongDescription>
        <ParameterProperties dataSource="local"/>
      </Parameter>

      <Parameter name="voc" parameterTypeRef="AQI_Index_Float32" shortDescription="VOC index">
        <LongDescription>VOC air-quality index value exposed by ESPHome/Home Assistant for AirQ1.</LongDescription>
        <ParameterProperties dataSource="local"/>
      </Parameter>

      <Parameter name="nox" parameterTypeRef="AQI_Index_Float32" shortDescription="NOx index">
        <LongDescription>NOx air-quality index value exposed by ESPHome/Home Assistant for AirQ1.</LongDescription>
        <ParameterProperties dataSource="local"/>
      </Parameter>

      <Parameter name="pm1" parameterTypeRef="PM1_Float32" shortDescription="PM1 mass concentration">
        <LongDescription>Particulate matter PM1 mass concentration in µg/m3.</LongDescription>
        <ParameterProperties dataSource="local"/>
      </Parameter>

      <Parameter name="pm2_5" parameterTypeRef="PM2_5_Float32" shortDescription="PM2.5 mass concentration">
        <LongDescription>Particulate matter PM2.5 mass concentration in µg/m3.</LongDescription>
        <ParameterProperties dataSource="local"/>
      </Parameter>

      <Parameter name="pm4" parameterTypeRef="PM4_Float32" shortDescription="PM4 mass concentration">
        <LongDescription>Particulate matter PM4 mass concentration in µg/m3.</LongDescription>
        <ParameterProperties dataSource="local"/>
      </Parameter>

      <Parameter name="pm10" parameterTypeRef="PM10_Float32" shortDescription="PM10 mass concentration">
        <LongDescription>Particulate matter PM10 mass concentration in µg/m3.</LongDescription>
        <ParameterProperties dataSource="local"/>
      </Parameter>

      <Parameter name="co2_temperature" parameterTypeRef="Temperature_Float32" shortDescription="CO2 sensor temperature">
        <LongDescription>Temperature reported by the CO2 sensing chain in degrees Celsius.</LongDescription>
        <ParameterProperties dataSource="local"/>
      </Parameter>

      <Parameter name="co2_humidity" parameterTypeRef="RH_Float32" shortDescription="CO2 sensor humidity">
        <LongDescription>Humidity reported by the CO2 sensing chain in %RH.</LongDescription>
        <ParameterProperties dataSource="local"/>
      </Parameter>

      <Parameter name="sen55_temperature" parameterTypeRef="Temperature_Float32" shortDescription="SEN55 temperature">
        <LongDescription>Temperature reported by the SEN55 sensing chain in degrees Celsius.</LongDescription>
        <ParameterProperties dataSource="local"/>
      </Parameter>

      <Parameter name="sen55_humidity" parameterTypeRef="RH_Float32" shortDescription="SEN55 humidity">
        <LongDescription>Humidity reported by the SEN55 sensing chain in %RH.</LongDescription>
        <ParameterProperties dataSource="local"/>
      </Parameter>

      <Parameter name="wifi_signal_db" parameterTypeRef="WiFiSignal_Int32" shortDescription="WiFi signal strength">
        <LongDescription>WiFi RSSI in dBm reported by the AirQ1 device.</LongDescription>
        <ParameterProperties dataSource="local"/>
      </Parameter>

    </ParameterSet>

    <ContainerSet>
      <SequenceContainer name="root" abstract="false">
        <EntryList>
          <ParameterRefEntry parameterRef="temperature"/>
          <ParameterRefEntry parameterRef="humidity"/>
          <ParameterRefEntry parameterRef="co2"/>
          <ParameterRefEntry parameterRef="voc"/>
          <ParameterRefEntry parameterRef="nox"/>
          <ParameterRefEntry parameterRef="pm1"/>
          <ParameterRefEntry parameterRef="pm2_5"/>
          <ParameterRefEntry parameterRef="pm4"/>
          <ParameterRefEntry parameterRef="pm10"/>
          <ParameterRefEntry parameterRef="co2_temperature"/>
          <ParameterRefEntry parameterRef="co2_humidity"/>
          <ParameterRefEntry parameterRef="sen55_temperature"/>
          <ParameterRefEntry parameterRef="sen55_humidity"/>
          <ParameterRefEntry parameterRef="wifi_signal_db"/>
        </EntryList>
      </SequenceContainer>
    </ContainerSet>

  </TelemetryMetaData>

</SpaceSystem>
